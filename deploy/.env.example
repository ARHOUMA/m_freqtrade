# Copy to deploy/.env (never commit that file) - or let the command in README.md generate it.

# Login for the freqtrade web UI (FreqUI) of both bots
FREQTRADE__API_SERVER__USERNAME=admin
FREQTRADE__API_SERVER__PASSWORD=change-me
FREQTRADE__API_SERVER__JWT_SECRET_KEY=change-me-long-random-string
FREQTRADE__API_SERVER__WS_TOKEN=change-me-random-string

# Optional Telegram notifications. Each bot needs its OWN bot token (create two bots with
# @BotFather); both can send to the same chat id.
SPOT_TELEGRAM_ENABLED=false
SPOT_TELEGRAM_TOKEN=
FUTURES_TELEGRAM_ENABLED=false
FUTURES_TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
